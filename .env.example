# All runtime models remain Meta models. Provider credentials stay on the server.
# Recommended while direct Meta billing is restricted:
MODEL_PROVIDER=baseten
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open
# For direct Meta access, set MODEL_PROVIDER=meta and configure:
MODEL_API_KEY=
META_MODEL=muse-wonder-1.0
# SAM 3.1 precise artwork extraction uses MODEL_API_KEY on the direct Meta API.
# Enabled by default for direct Meta. With Baseten, explicitly set true to use both.
# SAM_ENABLED=true
# Set SAM_ENABLED=false to disable remote SAM. An explicit local cutout provider can still run.
API_PORT=8787
# A small development request allowance; 0 disables requests. No automatic retries.
MAX_MODEL_REQUESTS=20

# Alternative credited host for the same Meta open-weight model:
# MODEL_PROVIDER=fireworks
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open

# Optional local Meta SAM 2.1 cutouts. Run npm run setup:cutouts first.
# CUTOUT_PROVIDER=local-sam2
# Explicit local selection does not use API keys or switch to paid remote SAM.
# LOCAL_SAM_PYTHON=/absolute/path/to/venv/bin/python
# LOCAL_SAM_CHECKPOINT=/absolute/path/to/sam2.1_hiera_tiny.pt
